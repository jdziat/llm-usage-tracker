<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="llmut"
        Arguments=""
        InstallLocation="C:\Program Files\jdziat\llmut">
    </Installer>
    <PackageInformation
        PackageName="llmut"
        PackageDisplayName="llmut"
        PublisherName="CN=jdziat"
        PublisherDisplayName="jdziat"
        Version="0.0.1.0"
        PackageDescription="Desktop shell for llmut usage analytics">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.jdziat.llmut"
                Description="Desktop shell for llmut usage analytics"
                DisplayName="llmut"
                ExecutableName="llmut"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>llmut</DisplayName>
            <PublisherDisplayName>jdziat</PublisherDisplayName>
            <Description>Desktop shell for llmut usage analytics</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="llmut.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
